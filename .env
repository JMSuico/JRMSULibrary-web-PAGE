# ==========================================
# JRMSU LIBRARY - ENVIRONMENT VARIABLES
# ==========================================
# Instructions: Copy this file to '.env' and fill in the values below before running Docker or the local server.

# ------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ------------------------------------------
# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY="replace-this-with-a-very-long-secure-random-string"

# Set to True for local development, False for production
DEBUG="False"

# A comma-separated list of IP addresses or domains your site can be hosted on
ALLOWED_HOSTS="*"

# A comma-separated list of origins allowed to make cross-origin requests
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Set to "True" to disable HTTPS redirects (required for local/Docker testing)
DISABLE_SSL_REDIRECT="True"

# ------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------
# Engine options: mssql, mysql, postgresql
DB_ENGINE="postgresql"
DB_NAME="jrmsu_library"
DB_USER="jrmsu_admin"
DB_PASSWORD="your-secure-db-password"
DB_HOST="localhost"   # Use "db" if running inside docker-compose
DB_PORT="5432"

# Only used if DB_ENGINE="mssql"
DB_MSSQL_DRIVER="ODBC Driver 17 for SQL Server"
DB_WINDOWS_AUTH="False"

# ------------------------------------------
# 3. EMAIL / SMTP CONFIGURATION / dont EVER TOUCH THIS 
# ------------------------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="katipunan.library@jrmsu.edu.ph"
EMAIL_HOST_PASSWORD="pwezdcvfsgnhqfrs"
DEFAULT_FROM_EMAIL="JRMSU-KC Library <katipunan.library@jrmsu.edu.ph>"
IMAP_HOST="imap.gmail.com"

# ------------------------------------------
# 4. REDIS & CELERY (BACKGROUND TASKS)
# ------------------------------------------
CELERY_BROKER_URL="redis://localhost:6379/0"    # Use "redis://redis:6379/0" inside docker-compose
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ------------------------------------------
# 5. AI OLLAMA CONFIGURATION
# ------------------------------------------
OLLAMA_URL="http://127.0.0.1:11434/api/chat"    # Use "http://ollama:11434/api/chat" inside docker-compose

# ------------------------------------------
# 6. EXTERNAL LIBRARY SERVICES
# ------------------------------------------
VITALSOURCE_EMAIL="your-vitalsource-email"
VITALSOURCE_PASSWORD="your-vitalsource-password"

SCHOLAAR_USERNAME="your-scholaar-username"
SCHOLAAR_PASSWORD="your-scholaar-password"

# ------------------------------------------
# 7. FRONTEND VITE CONFIGURATION (For React)
# ------------------------------------------
# Define where the frontend should point for API calls
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
