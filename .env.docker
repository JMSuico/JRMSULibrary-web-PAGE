# JRMSU Library System — Docker Environment Variables Template
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the real .env to git.

# --- Layer 4 & 6: Database & Redis Cache ------------------------------------
DB_PASSWORD=change_me_strong_db_password_here
REDIS_PASSWORD=change_me_strong_redis_password_here

# --- Layer 3: Backend Security & Routing ------------------------------------
# Primary key read by Django settings.py and Docker Compose (50+ random chars)
SECRET_KEY=change_me_generate_a_50_char_random_string_here
DEBUG=False
DJANGO_DEBUG=False
# Keep False in HTTPS/Cloudflare production; set True ONLY for plain HTTP local dev
DISABLE_SSL_REDIRECT=False

# Explicit host & origin allowlists (never use * in production)
ALLOWED_HOSTS=page.jrmsukc-library.online,admin.jrmsukc-library.online,localhost,127.0.0.1,backend
ALLOWED_CORS_ORIGINS=https://page.jrmsukc-library.online,https://admin.jrmsukc-library.online,http://localhost:3000,http://localhost:3001
ADMIN_BIND_IP=127.0.0.1

# --- Layer 1/Edge: Cloudflare Tunnel (for CommandStart scripts) -------------
CF_TUNNEL_TOKEN=change_me_cloudflare_tunnel_token
